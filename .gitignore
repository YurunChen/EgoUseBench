__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
*.egg-info/
/build/
/dist/
.env
.env.*
!.env.example
.DS_Store
/启动人工执行.command

# Review materials and historical experiments; referenced evidence must be retained.
artifacts/*
!artifacts/README.md

# Third-party datasets/checkouts are mounted locally, never committed here.
reference/*
!reference/README.md

# Local scratch notes and temporary review exports.
.scratch/

# Observation inputs and local research media. Keep the task definitions.
/data/observations/
/data/archive/
/data/final-tasks/
/data/final-tasks.building/
/data/experiments/assets/
/data/experiments/controlled-variable-evidence.json
/data/experiments/variants/**/*.jpg
/data/experiments/variants/**/*.jpeg
/data/experiments/variants/**/*.png
/data/experiments/variants/**/*.webp
/data/experiments/variants/**/*.mp4

# Raw captures stay local. These nine publisher records are needed to read
# the frozen EgoMedia catalog even when no media is installed.
/data/sources/upstream_detail_snapshots/*
!/data/sources/upstream_detail_snapshots/youtube/
/data/sources/upstream_detail_snapshots/youtube/*
!/data/sources/upstream_detail_snapshots/youtube/83_bL7k8j2U.json
!/data/sources/upstream_detail_snapshots/youtube/JwiQbvlKOLw.json
!/data/sources/upstream_detail_snapshots/youtube/PohOqNzE6cs.json
!/data/sources/upstream_detail_snapshots/youtube/RxgTQYydH34.json
