  "instructions": {
    "base": "I'm stocking another tea corner. I need a spare of the item I mean among these two: the tool held over the cup, or a kitchen knife like the ones in the block behind the cup. Match the item's function, not its brand or colour. Also add a pack of the same kind of fresh fruit I use for this drink. Any brand or pack size is fine."
  },
  "composite_events": [
    {
      "kind": "graft",
      "onset_seconds": 67.0,
      "request": "Rather than restocking the fresh fruit, add one manual tool for extracting its juice. Keep the first spare item."
    },
    {
      "kind": "refresh",
      "onset_seconds": 115.0
    },
    {
      "kind": "graft",
      "onset_seconds": 124.0,
      "request": "For quicker drinks, replace that juice-extracting tool with one bottle of unsweetened juice from the same fruit. Keep the first spare item and do not keep the fresh fruit or the extra juice tool."
    }
  ],
